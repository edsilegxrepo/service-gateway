{
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "120s"
  },
  "auth": {
    "master_key_path": "master.key",
    "nonce_ttl": "5m",
    "keys": {
      "ga-production": {
        "encrypted_secret": "your-secret-here",
        "services": ["*"],
        "roles": ["read"],
        "description": "GoAnywhere production key"
      }
    },
    "rate_limit": {
      "enabled": true,
      "requests_per_min": 600,
      "burst_size": 50
    },
    "ip_rules": {
      "enabled": false,
      "allow_list": ["127.0.0.1"],
      "deny_list": []
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "security": {
    "lock_memory": false
  },
  "services_dir": "services"
}
